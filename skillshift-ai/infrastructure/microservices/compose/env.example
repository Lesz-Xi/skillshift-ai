# MLBB Coach AI - Microservices Environment Configuration

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Redis Configuration
REDIS_URL=redis://redis:6379

# Service URLs (for API Gateway)
OCR_SERVICE_URL=http://ocr-service:8001
DETECTION_SERVICE_URL=http://detection-service:8002
ANALYSIS_SERVICE_URL=http://analysis-service:8003

# Database Configuration (if using PostgreSQL)
DATABASE_URL=postgresql://user:password@postgres:5432/mlbb_coach_ai

# Monitoring Configuration
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000

# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Performance Configuration
MAX_WORKERS=4
CACHE_TTL=300
BATCH_SIZE=10

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_YOLO_DETECTION=true
ENABLE_BEHAVIORAL_ANALYSIS=true
ENABLE_TACTICAL_COACHING=true
ENABLE_REAL_TIME_ANALYSIS=true

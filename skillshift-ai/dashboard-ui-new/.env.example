# Frontend (Next.js) environment variables

# Backend base URL used by Next.js API routes to reach FastAPI
SKILLSHIFT_AI_URL=http://localhost:8000

# Default IGN for analysis if not provided by the client
DEFAULT_IGN=Lesz XVII

# Toggle fast/instant analysis (proxy will pick endpoint)
USE_FAST_ANALYSIS=false

# Override backend analysis endpoint (default: /api/analyze)
# NEXT_PUBLIC_ANALYZE_ENDPOINT=/api/analyze


#############################
# SkillShift AI (Backend)   #
#############################

# Redis (choose one style)
# Upstash/Redis Cloud URL formats
# REDIS_URL=redis://:<password>@<host>:<port>
# Or Upstash HTTPS URL with token
# REDIS_URL=https://<host>:<port>
# REDIS_TOKEN=<token>

# Local Redis fallback
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# Default player IGN used when not specified
# DEFAULT_IGN=Lesz XVII

# Log level (info|debug|warning|error)
# LOG_LEVEL=info

# Optional: Force temp upload directory (defaults to /tmp/skillshift_uploads)
# UPLOAD_DIR=/tmp/skillshift_uploads

